---
import BaseLayout from "../layouts/BaseLayout.astro";

const site = {
	name: "Sokoyuku",
	description:
		"",
};
const heroTitle = "Build or Chat with AI models just like your contacts";
const heroSubtitle = site.description;
const faqItems = [
	{
		question: "What is a prototype?",
		answer:
			"A prototype is an AI prototype a creator sets up. It has a name, a description, and the address of the station that runs it. The creator can keep it private, or publish it so other people can add it as a model.",
	},
	{
		question: "What is a model?",
		answer:
			"A model is your own running use of a prototype. Add a prototype as a model to use it. You can add the same prototype more than once, each with its own name. Each model has its own accounts and chats. Those models all run on that prototype's station.",
	},
	{
		question: "What is a station?",
		answer:
			"A station is the program a creator runs to host a prototype. It runs each model of that prototype and produces the replies.",
	},
	{
		question: "What is an account?",
		answer:
			"An account is a bot or messaging account you own on Telegram, Discord, Matrix, QQ, or WhatsApp. Connect it and assign it to one model. A model can use more than one account. Messages sent to an account go to its model, and the model replies through that account.",
	},
	{
		question: "What is local vs cloud?",
		answer: [
			"A local prototype, its models, and your local accounts are used together on a station you run. The prototype is private and free, and every model of it is a local model. A local account's credentials are encrypted so only that station can read them. That station carries messages between the accounts and corresponding models inside it.",
			"With cloud, Sokoyuku carries messages between the accounts and corresponding models in the prototype's station.",
		],
	},
];
const appSite = "https://app.sokoyuku.com";
const pricingPlans = [
	{
		name: "Free",
		price: "$0",
		period: "/month",
		description: "Access to most features included with free plan, limits applied",
		ctaLabel: "Start Free",
		ctaHref: "#cta",
		featured: false,
		features: [
			"Up to 10 cloud accounts",
			"Up to 40 local accounts",
			"Up to 40 models",
			"Up to 20 prototypes",

		],
	},
	{
		name: "Pro",
		price: "$9.99",
		period: "/month",
		description: "Access to all features with higher limits",
		ctaLabel: "Get Pro",
		ctaHref: "#cta",
		featured: true,
		features: [
			"Up to 60 cloud accounts (valid until subscription end)",
			"Up to 240 local accounts (valid until subscription end)",
			"Up to 240 models (Permanent upgrade)",
			"Up to 120 prototypes (Permanent upgrade)",
		],
	},
];
const year = new Date().getFullYear();

---

<BaseLayout title={site.name} description={site.description} appSite={appSite}>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="hero-title" data-i18n={heroTitle}>{heroTitle}</h1>
			<p class="hero-subtitle">{heroSubtitle}</p>

			<div class="hero-actions" id="cta">
				<a class="button button-lg" href={appSite} data-i18n="Start now">Start now</a>
				<a class="button button-lg button-ghost button-ghost-learn" href="#how" data-i18n="Learn more">Learn more</a>
			</div>
		</div>
	</section>

	<section class="section section-alt" id="how">
		<div class="container">
			<div class="section-head">
				<h2 data-i18n="Start your chats">Start your chats</h2>
				<p data-i18n="Simple flow from sign-in to your first chat.">Simple flow from sign-in to your first chat.</p>
			</div>

			<div class="how-panel" aria-label="Workflow" data-i18n-aria="Workflow">
				<div class="how-panel-top">
					<div class="how-panel-title" data-i18n="Workflow">Workflow</div>
				</div>
				<ol class="how-steps">
					<li class="how-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
								/>
							</svg>
						</div>
						<div class="how-step-body">
							<div class="how-step-title" data-i18n="Sign in">Sign in</div>
							<div class="how-step-desc" data-i18n="Create a new account or sign in with existing one">Create a new account or sign in with existing one</div>
						</div>
					</li>

					<li class="how-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"
								/>
							</svg>
						</div>
						<div class="how-step-body">
							<div class="how-step-title" data-i18n="Add account">Add account</div>
							<div class="how-step-desc" data-i18n="Add a Telegram/Matrix/Discord/WhatsApp/QQ account or any local account">
								Add a Telegram/Matrix/Discord/WhatsApp/QQ account or any local account
							</div>
						</div>
					</li>

					<li class="how-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
								/>
							</svg>
						</div>
						<div class="how-step-body">
							<div class="how-step-title" data-i18n="Search prototype">Search prototype</div>
							<div class="how-step-desc" data-i18n="Find a prototype you like">
								Find a prototype you like
							</div>
						</div>
					</li>

					<li class="how-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z"
								/>
							</svg>
						</div>
						<div class="how-step-body">
							<div class="how-step-title" data-i18n="Create model">Create model</div>
							<div class="how-step-desc" data-i18n="Create a model from the chosen prototype">
								Create a model from the chosen prototype
							</div>
						</div>
					</li>

					<li class="how-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"
								/>
							</svg>
						</div>
						<div class="how-step-body">
							<div class="how-step-title" data-i18n="Open chat">Open chat</div>
							<div class="how-step-desc" data-i18n="Open a chat with the model and start chatting">
								Open a chat with the model and start chatting
							</div>
						</div>
					</li>
				</ol>
			</div>
		</div>
	</section>

	<section class="section" id="developers">
		<div class="container">
			<div class="section-head">
				<h2 data-i18n="Create your own prototype">Create your own prototype</h2>
				<p data-i18n="Find a template, create your own prototype, then register the prototype.">Find a template, create your own prototype, then register the prototype.</p>
			</div>

			<div class="how-panel" aria-label="Developer workflow" data-i18n-aria="Developer workflow">
				<div class="flow-steps" aria-label="Developer workflow steps" data-i18n-aria="Developer workflow steps">
					<div class="flow-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
								/>
							</svg>
						</div>
						<div class="flow-step-body">
							<div class="how-step-title" data-i18n="Find templates">Find templates</div>
							<div class="how-step-desc">
								<span data-i18n="Start from official templates on GitHub:">Start from official templates on GitHub:</span>
								<a
									href="https://github.com/sokoyuku"
									target="_blank"
									rel="noopener noreferrer"
									>github.com/sokoyuku</a
								>
							</div>
						</div>
					</div>

					<div class="flow-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M12 6v12m6-6H6"
								/>
							</svg>
						</div>
						<div class="flow-step-body">
							<div class="how-step-title" data-i18n="Create your own prototype">Create your own prototype</div>
							<div class="how-step-desc" data-i18n="Clone a template and tailor it to your needs.">
								Clone a template and tailor it to your needs.
							</div>
						</div>
					</div>

					<div class="flow-step">
						<div class="how-step-icon" aria-hidden="true">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
								/>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M10 8.25v7.5L16 12l-6-3.75Z"
								/>
							</svg>
						</div>
						<div class="flow-step-body">
							<div class="how-step-title" data-i18n="Run station">Run station</div>
							<div class="how-step-desc" data-i18n="Sign in and run station to register the prototype.">
								Sign in and run station to register the prototype.
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="security">
		<div class="container">
			<div class="section-head">
				<h2 data-i18n="Keep your data safe">Keep your data safe</h2>
				<p data-i18n="How Sokoyuku keeps your data safe, and what you can do to keep them safe.">How Sokoyuku keeps your data safe, and what you can do to keep them safe.</p>
			</div>

			<div class="security-row" aria-label="Security highlights" data-i18n-aria="Security highlights">
				<div class="security-item">
					<div class="security-title" data-i18n="Sign-in and payments">Sign-in and payments</div>
					<div class="security-desc" data-i18n="Your password is stored only as a hash. If you sign in with Google or Telegram, Sokoyuku stores the account identifier they send. Stripe handles the card, and Sokoyuku does not store the card number.">
						Your password is stored only as a hash. If you sign in with Google or Telegram, Sokoyuku stores the account identifier they send. Stripe handles the card, and Sokoyuku does not store the card number.
					</div>
				</div>

				<div class="security-item">
					<div class="security-title" data-i18n="Messages">Messages</div>
					<div class="security-desc" data-i18n="Sokoyuku does not keep the content of your messages. It keeps metadata of messages for a limited time, such as which account and chat a message belonged to, and when. Voice calls are not recorded.">
						Sokoyuku does not keep the content of your messages. It keeps metadata of messages for a limited time, such as which account and chat a message belonged to, and when. Voice calls are not recorded.
					</div>
				</div>

				<div class="security-item">
					<div class="security-title" data-i18n="Run your own station">Run your own station</div>
					<div class="security-desc" data-i18n="You may run your own station for a local prototype, its models, and your local accounts. Local accounts' credentials and local model settings are encrypted so only that station can read them. That station handles the messages.">
						You may run your own station for a local prototype, its models, and your local accounts. Local accounts' credentials and local model settings are encrypted so only that station can read them. That station handles the messages.
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-alt" id="pricing">
		<div class="container">
			<div class="section-head">
				<h2 data-i18n="Pricing">Pricing</h2>
				<p data-i18n="Choose a plan that suits your needs.">Choose a plan that suits your needs.</p>
			</div>

			<div class="pricing-grid" aria-label="Pricing plans" data-i18n-aria="Pricing plans">
				{pricingPlans.map((plan) => (
					<article class:list={["pricing-card", plan.featured && "pricing-card-featured"]}>
						<div class="pricing-top">
							<div>
								<div class="pricing-name" data-i18n={plan.name}>{plan.name}</div>
								<p class="pricing-desc" data-i18n={plan.description}>{plan.description}</p>
							</div>
						</div>

						<div class="pricing-price-row">
							<span class="pricing-price">{plan.price}</span>
							<span class="pricing-period" data-i18n={plan.period}>{plan.period}</span>
						</div>

						<ul class="pricing-features">
							{plan.features.map((feature) => (
								<li data-i18n={feature}>{feature}</li>
							))}
						</ul>

						<a
							class:list={["button", "button-lg", !plan.featured && "button-ghost", !plan.featured && "button-ghost-learn"]}
							href={plan.featured ? `${appSite}?plan=pro` : appSite}
							data-i18n={plan.ctaLabel}
						>
							{plan.ctaLabel}
						</a>
					</article>
				))}
			</div>

			<p class="pricing-footnote">
			</p>
		</div>
	</section>

	<section class="section section-alt" id="faq">
		<div class="container">
			<div class="section-head">
				<h2 data-i18n="FAQ">FAQ</h2>
			</div>

			<div class="faq">
				{faqItems.map((item) => (
					<details class="qa">
						<summary>
							<span data-i18n={item.question}>{item.question}</span>
							<span class="qa-toggle" aria-hidden="true"></span>
						</summary>
						{(Array.isArray(item.answer) ? item.answer : [item.answer]).map((paragraph) => (
							<p data-i18n={paragraph}>{paragraph}</p>
						))}
					</details>
				))}
			</div>

		</div>
	</section>
</BaseLayout>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		font-weight: 500;
		font-family: inherit;
		font-size: 0.875rem;
		border: 1px solid transparent;
		white-space: nowrap;
		user-select: none;
		background-color: var(--color-primary);
		color: var(--color-text-inverse);
		box-shadow: var(--button-shadow);
		transition: transform 0.2s ease, filter 0.2s ease-in-out, box-shadow 0.2s ease-in-out,
			background-color 0.2s ease-in-out;
	}

	.button:hover {
		text-decoration: none;
		background-color: var(--color-primary-hover);
		color: var(--color-text-inverse);
		box-shadow: var(--shadow-sm);
		transform: translateY(-1px);
	}

	.button:active {
		filter: brightness(95%);
		box-shadow: none;
		transform: translateY(0);
	}

	.button:focus-visible {
		outline: none;
		box-shadow: var(--button-focus-shadow);
	}

	.button-ghost {
		background-color: var(--color-bg-surface);
		border-color: var(--color-border);
		color: var(--color-text-main);
		box-shadow: none;
	}

	.button-ghost:hover {
		filter: none;
		background: var(--color-bg-hover);
		color: var(--color-text-main);
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}

	.button-ghost-learn:hover {
		background: var(--color-bg-surface);
		color: var(--color-success);
	}

	.button-lg {
		padding: 0.75rem 1.25rem;
		font-size: 1rem;
	}

    /* Component specific styles */
	.section {
		padding: 3rem 0;
	}

	.section-alt {
		background: transparent;
		border-top: none;
		border-bottom: none;
	}

	.section-head h2 {
		margin: 0 0 8px;
		font-size: clamp(1.55rem, 2.1vw, 1.9rem);
		letter-spacing: -0.5px;
		font-weight: 800;
		color: var(--color-heading);
	}

	.section-head p {
		margin: 0 0 18px;
		color: var(--color-text-secondary);
		max-width: 70ch;
	}

	.section-head {
		text-align: center;
	}

	.section-head p {
		margin-left: auto;
		margin-right: auto;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.card {
		border-radius: 12px;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		padding: 16px;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: color-mix(in srgb, var(--color-border), var(--color-primary) 16%);
	}

	.card h3 {
		margin: 0 0 8px;
		font-size: 1rem;
		color: var(--color-text-main);
	}

	.card p {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 14px;
	}

	.how-panel {
		border-radius: 12px;
		background: var(--color-bg-surface);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-md);
		overflow: hidden;
		max-width: 52rem;
		margin: 0 auto;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.how-panel:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-lg);
		border-color: color-mix(in srgb, var(--color-border), var(--color-primary) 14%);
	}

	.how-panel + .how-panel {
		margin-top: 14px;
	}

	.how-panel-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 14px;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-surface);
	}

	.how-panel-title {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.how-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}

	.how-step {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px;
		border-top: 1px solid var(--color-border-light);
	}

	.how-step:first-child {
		border-top: none;
	}

	.how-step-icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary-soft);
		color: var(--color-primary);
		border: 1px solid color-mix(in srgb, var(--color-primary), transparent 70%);
		flex: 0 0 auto;
	}

	.how-step-icon svg {
		width: 18px;
		height: 18px;
		display: block;
	}

	.how-step-body {
		min-width: 0;
		flex: 1;
	}

	.flow-steps {
		display: flex;
		align-items: stretch;
		justify-content: center;
		gap: 0;
		background: var(--flow-gradient);
	}

	.flow-step {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px;
		min-width: 0;
	}

	.flow-step + .flow-step {
		border-left: none;
	}

	.flow-step-body {
		min-width: 0;
	}

	@media (max-width: 720px) {
		.flow-steps {
			flex-direction: column;
			align-items: stretch;
		}

		.flow-step + .flow-step {
			border-left: none;
			border-top: none;
		}
	}

	.how-step-title {
		font-weight: 600;
		color: var(--color-text-main);
	}

	.how-step-desc {
		margin-top: 2px;
		color: var(--color-text-secondary);
		font-size: 14px;
	}

	.security-row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		max-width: 52rem;
		margin: 0 auto;
	}

	.security-item {
		border-radius: 12px;
